# Development: leave unset — Vite proxy rewrites /api → http://localhost:8000/api
# Production:  set to your backend's full URL, e.g. https://api.example.com/api
# VITE_API_BASE_URL=https://api.example.com/api

# Sentry — remove or leave blank to disable frontend error tracking
# VITE_SENTRY_DSN=https://xxxxx@oyyy.ingest.sentry.io/zzzzz
