# Django security — generate a new secret key for every environment
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-here

DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# PostgreSQL
DB_NAME=coaching_db
DB_USER=coaching_user
DB_PASSWORD=your-db-password-here
DB_HOST=db
DB_PORT=5432

# CORS — list your frontend URLs
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

DJANGO_LOG_LEVEL=WARNING

# Email — use SMTP for production, leave as console for local dev
# For Gmail: create an App Password (Google Account > App Passwords)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-here
DEFAULT_FROM_EMAIL=Football Academy <noreply@yourdomain.com>
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
